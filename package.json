{
	"name": "s3-query-json",
	"version": "3.0.0",
	"description": "Query (ND)JSON files on S3",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"require": "./lib/index.js",
			"default": "./lib/index.js"
		}
	},
	"packageManager": "npm@11.11.0",
	"scripts": {
		"format": "prettier --write \"source/**/*.ts\" \"test/**/*.ts\"",
		"build": "npm run clean && tsc -p tsconfig.json",
		"test": "npm run build && node --import tsx --test test/query.ts",
		"clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
		"prepare": "npm run build",
		"prepack": "npm test",
		"deploy": "npm run prepare && npx np"
	},
	"keywords": [
		"S3",
		"JSON",
		"NDJSON",
		"SQL"
	],
	"engines": {
		"node": ">=22"
	},
	"files": [
		"lib"
	],
	"author": {
		"name": "Simon Jang",
		"email": "simon.jang.contact@gmail.com",
		"url": "github.com/SimonJang"
	},
	"repository": "SimonJang/s3-query-json",
	"license": "MIT",
	"dependencies": {},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"aws-sdk": "^2.1693.0",
		"prettier": "^3.8.4",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"aws-sdk": "^2.330.0"
	}
}
